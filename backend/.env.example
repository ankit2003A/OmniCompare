# Default: local SQLite (zero setup). For PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://omni:omni@localhost:5432/omnicompare
DATABASE_URL=sqlite:///./omnicompare.db

# Matching weights (must sum to 1.0) and thresholds
MATCH_WEIGHT_TEXT=0.40
MATCH_WEIGHT_ATTRIBUTE=0.25
MATCH_WEIGHT_IMAGE=0.35
MATCH_THRESHOLD_EXACT=0.90
MATCH_THRESHOLD_SIMILAR=0.70

# AI providers: "hashing" (built-in, deterministic) | "openai" (stub, needs key)
EMBEDDING_PROVIDER=hashing
IMAGE_SIMILARITY_PROVIDER=placeholder
OPENAI_API_KEY=

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
